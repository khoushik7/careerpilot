# ==============================================================================
# SMART CAREER COACH - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. MONGODB ATLAS DATABASE CONFIGURATION (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Create a free M0 cluster at https://cloud.mongodb.com
# 1. Under Database Access, create a user with "Read and write to any database".
# 2. Under Network Access, add IP Address 0.0.0.0/0 (Allow access from anywhere).
# 3. Click "Connect" -> "Drivers" -> copy connection string.
# Replace <username>, <password>, and <dbname> with your credentials:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartcareercoach?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# 32+ character random string for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND DOMAINS
# ------------------------------------------------------------------------------
# Set this to the public URL of your deployed frontend (Render Static Site)
CLIENT_URL=https://smartcareercoach.onrender.com
FRONTEND_URL=https://smartcareercoach.onrender.com

# ------------------------------------------------------------------------------
# 4. OPTIONAL: AI EVALUATION ENGINE
# ------------------------------------------------------------------------------
# If set, Gemini 1.5 Flash provides enhanced LLM interview answer evaluation.
# If omitted, the built-in algorithmic speech & NLP evaluation engine is used.
# Get free key: https://aistudio.google.com
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. OPTIONAL: PASSWORD RESET EMAIL DELIVERY (NODEMAILER)
# ------------------------------------------------------------------------------
# For Gmail: generate an App Password in your Google Account security settings.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
